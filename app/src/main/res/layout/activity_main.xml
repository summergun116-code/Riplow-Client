<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/riplow_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="174dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_sidebar">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RIPLOW"
                android:textColor="@color/riplow_foreground"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.09" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="MINECRAFT TOOLKIT"
                android:textColor="@color/riplow_muted"
                android:textSize="8sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/version_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip"
                android:text="Riplow 1.5"
                android:textColor="@color/riplow_secondary"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="@color/riplow_border" />

            <Button
                android:id="@+id/nav_home"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_nav_active"
                android:text="Home" />

            <Button
                android:id="@+id/nav_performance"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="FPS" />

            <Button
                android:id="@+id/nav_replay"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="Replay" />

            <Button
                android:id="@+id/nav_accounts"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="Accounts" />

            <Button
                android:id="@+id/nav_packs"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="Packs" />

            <Button
                android:id="@+id/nav_modules"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="Modules" />

            <Button
                android:id="@+id/nav_network"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="Network" />

            <Button
                android:id="@+id/nav_settings"
                style="@style/Widget.Riplow.NavButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:text="Settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/module_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="5dp"
                android:text="Minecraft tools"
                android:textColor="@color/riplow_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip"
                android:text="@string/launcher_status"
                android:textColor="@color/riplow_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="17dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/page_header"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/page_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="@color/riplow_foreground"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/page_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/riplow_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:background="@drawable/bg_chip"
                    android:text="BEDROCK"
                    android:textColor="@color/riplow_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/page_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="18dp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/launch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#E8090A0C">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/bg_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPENING MINECRAFT"
                android:textColor="@color/riplow_muted"
                android:textSize="9sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Riplow → Minecraft"
                android:textColor="@color/riplow_foreground"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loading_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Opening your installed Minecraft…"
                android:textColor="@color/riplow_secondary"
                android:textSize="11sp" />

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
