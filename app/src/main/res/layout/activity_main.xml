<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/riplow_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RIPLOW"
                android:textColor="@color/riplow_foreground"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/version_chip"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:background="@drawable/bg_chip"
                android:text="Riplow 1.3"
                android:textColor="@color/riplow_secondary"
                android:textSize="10sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="@drawable/bg_chip"
                android:text="@string/launcher_status"
                android:textColor="@color/riplow_foreground"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical">

            <Button android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="HOME" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/nav_modules" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="MODULES" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/nav_packs" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="PACKS" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/nav_performance" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="PERFORMANCE" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/nav_network" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="NETWORK" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="SETTINGS" android:textAllCaps="false" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/riplow_foreground"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/page_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/riplow_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/page_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp"/>
        </ScrollView>

        <TextView
            android:id="@+id/module_count"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:text="36 focused Minecraft modules"
            android:textColor="@color/riplow_muted"
            android:textSize="9sp"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/launch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#EF090A0C">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/bg_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPENING MINECRAFT"
                android:textColor="@color/riplow_muted"
                android:textSize="9sp"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Riplow → Minecraft"
                android:textColor="@color/riplow_foreground"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/loading_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Opening your installed Minecraft…"
                android:textColor="@color/riplow_secondary"
                android:textSize="11sp"/>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
