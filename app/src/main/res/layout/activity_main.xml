<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/riplow_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_surface">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RIPLOW"
                android:textColor="@color/riplow_foreground"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bedrock companion"
                android:textColor="@color/riplow_secondary"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="24dp"
                android:text="HOME&#10;&#10;MINECRAFT&#10;&#10;MODS&#10;&#10;ADD-ONS&#10;&#10;PACKS&#10;&#10;PERFORMANCE&#10;&#10;NETWORK&#10;&#10;HUD&#10;&#10;PROFILES&#10;&#10;SETTINGS"
                android:textColor="@color/riplow_secondary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/version_chip"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:text="0.1.1"
                android:textColor="@color/riplow_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Minecraft companion"
                            android:textColor="@color/riplow_foreground"
                            android:textSize="27sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Landscape-first launcher, utilities and client controls."
                            android:textColor="@color/riplow_secondary"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:background="@drawable/bg_chip"
                        android:text="@string/launcher_status"
                        android:textColor="@color/riplow_foreground"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/bg_surface">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MINECRAFT BEDROCK"
                            android:textColor="@color/riplow_muted"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/core_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/riplow_secondary"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/diagnostics"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/riplow_secondary"
                            android:textSize="11sp"/>

                        <Button
                            android:id="@+id/launch_button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_button_primary"
                            android:text="▶  Launch Minecraft"
                            android:textAllCaps="false"
                            android:textColor="#0B0C0E"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/bg_surface">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RIPLOW SYSTEMS"
                            android:textColor="@color/riplow_muted"
                            android:textSize="10sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="24 registered helper modules"
                            android:textColor="@color/riplow_foreground"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginTop="7dp"
                            android:text="HUD • Performance • Network • Packs • Add-ons • Profiles"
                            android:textColor="@color/riplow_secondary"
                            android:textSize="12sp"/>

                        <Button
                            android:id="@+id/client_button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_button"
                            android:text="Open Client Menu"
                            android:textAllCaps="false"
                            android:textColor="@color/riplow_foreground"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_surface">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PACK CENTER"
                            android:textColor="@color/riplow_muted"
                            android:textSize="10sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Resource packs • behavior packs • profiles"
                            android:textColor="@color/riplow_foreground"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_surface">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PERFORMANCE"
                            android:textColor="@color/riplow_muted"
                            android:textSize="10sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Telemetry • frame timing • battery-aware profiles"
                            android:textColor="@color/riplow_foreground"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_surface">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NETWORK"
                            android:textColor="@color/riplow_muted"
                            android:textSize="10sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="RakNet/UDP diagnostics • jitter • packet loss"
                            android:textColor="@color/riplow_foreground"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/diagnostics_button"
                    android:layout_width="220dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button"
                    android:text="Refresh diagnostics"
                    android:textAllCaps="false"
                    android:textColor="@color/riplow_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/launch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#E6090A0C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="34dp">

            <TextView
                android:id="@+id/loading_logo"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:gravity="center"
                android:text="R"
                android:textColor="@color/riplow_foreground"
                android:textSize="44sp"
                android:textStyle="bold"
                android:background="@drawable/bg_surface"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/loading_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Starting Minecraft"
                    android:textColor="@color/riplow_foreground"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/loading_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Checking installation…"
                    android:textColor="@color/riplow_secondary"
                    android:textSize="13sp"/>

                <ProgressBar
                    android:id="@+id/loading_progress"
                    android:layout_width="220dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="22dp"
                    android:indeterminate="true"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
