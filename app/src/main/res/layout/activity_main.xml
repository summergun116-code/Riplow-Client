<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/riplow_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RIPLOW"
                    android:textColor="@color/riplow_foreground"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/version_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:background="@drawable/bg_chip"
                    android:text="0.1.1"
                    android:textColor="@color/riplow_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_tagline"
                android:textColor="@color/riplow_secondary"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_surface">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_status"
                    android:textColor="@color/riplow_foreground"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/launcher_subtitle"
                    android:textColor="@color/riplow_secondary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/core_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/riplow_muted"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/diagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/riplow_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/client_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/open_client"
                android:textAllCaps="false"
                android:textColor="#0B0C0E"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/launch_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button"
                android:text="@string/launch_minecraft"
                android:textAllCaps="false"
                android:textColor="@color/riplow_foreground"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/diagnostics_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button"
                android:text="@string/refresh_diagnostics"
                android:textAllCaps="false"
                android:textColor="@color/riplow_secondary"
                android:textSize="13sp"/>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/launch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#E6090A0C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/loading_logo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:gravity="center"
                android:text="R"
                android:textColor="@color/riplow_foreground"
                android:textSize="46sp"
                android:textStyle="bold"
                android:background="@drawable/bg_surface"/>

            <TextView
                android:id="@+id/loading_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Starting Minecraft"
                android:textColor="@color/riplow_foreground"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/loading_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Checking installation…"
                android:textColor="@color/riplow_secondary"
                android:textSize="13sp"/>

            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="180dp"
                android:layout_height="3dp"
                android:layout_marginTop="26dp"
                android:indeterminate="true"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
