<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#17181C" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#292B31" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#3A3D45" android:endColor="#292B31" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#565A65" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#2A2C32" android:endColor="#202126" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#3A3C44" />
        </shape>
    </item>
</selector>
