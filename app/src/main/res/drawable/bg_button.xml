<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#2017191D" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#30292B31" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#55FFFFFF" android:endColor="#2AFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#64FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#332F323A" android:endColor="#2220232A" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#42FFFFFF" />
        </shape>
    </item>
</selector>
